/-- Código que realiza potencia sem utilizar
o operador especifico do quinas --/ 

-- funçao pot
[ numero Potencia [numero base | numero expoente]: 
    [

	  || expoente == 0 = 1

	  || # = base . Potencia [base | expoente - 1]
  
    ]
]


++ [ numero Main []:    
    [
      [ ¨ numero resultadoPotencia [Potencia [4 | 2]] ]
      
      [
        || <resultadoPotencia << -16 v resultadoPotencia >> 16> ^ ¬ <resultadoPotencia == -32 v resultadoPotencia == 32> = 1
        || # = 0 
      ]
    ]
]



